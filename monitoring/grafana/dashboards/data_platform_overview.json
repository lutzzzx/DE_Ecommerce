{
    "title": "Data Platform Overview",
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "10s",
    "panels": [
        {
            "id": 1,
            "title": "Kafka - Messages In Per Second",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 0
            },
            "targets": [
                {
                    "expr": "rate(kafka_topic_partition_current_offset{topic=\"ecommerce.events\"}[1m])",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 2,
            "title": "Kafka Consumer Group Lag",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 0
            },
            "targets": [
                {
                    "expr": "kafka_consumergroup_lag{topic=\"ecommerce.events\"}",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 3,
            "title": "Postgres Warehouse - Active Connections",
            "type": "stat",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 8
            },
            "targets": [
                {
                    "expr": "pg_stat_activity_count{datname=\"warehouse\"}",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 4,
            "title": "Airflow - Task Failures (via StatsD)",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 8
            },
            "targets": [
                {
                    "expr": "increase(airflow_ti_failures_total[15m])",
                    "refId": "A"
                }
            ]
        }
    ]
}